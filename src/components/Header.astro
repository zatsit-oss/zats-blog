---
/**
 * Site header, the same bar as corporate, the sustainability portal and the
 * tech watcher, so a reader moving between the four zatsit sites never
 * re-learns it. Corporate's `Header.astro` is the reference.
 *
 * Left to right, and in this order everywhere:
 *   1. brand: sigle plus the "zatsit" wordmark, the wordmark only from 1024px
 *   2. page navigation, collapsed behind the menu button below 1024px
 *   3. ecosystem icons, always visible: the two sibling sites, then LinkedIn,
 *      GitHub, mail
 *   4. theme toggle
 *   5. menu button, below 1024px only
 *
 * Only the navigation entries and the two sibling sites differ from site to
 * site. Here the siblings are the corporate website and the sustainability
 * portal: pointing a reader of the blog at the blog would be a link to
 * nowhere.
 *
 * The search field is this site's alone, and takes its own row below 1024px.
 *
 * Class names stay BEM, which is this repository's convention; corporate is a
 * Tailwind project, so the utility classes never carried over anyway. What is
 * shared is the rendered result and the metrics, listed in the style block
 * below against the same breakpoints the other three sites use.
 */
import { Globe, Mail, Menu, X } from '@lucide/astro';
import GithubIcon from '../assets/icons/github.svg';
import LinkedinIcon from '../assets/icons/linkedin.svg';
import SustainabilityIcon from '../assets/icons/sustainability.svg';
import LogoIcon from '../assets/icons/logo.svg';
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import {
  NAV_LINKS,
  GITHUB_URL,
  LINKEDIN_URL,
  SUSTAINABILITY_URL,
  WEBSITE_URL,
  CONTACT_EMAIL,
} from '../consts';

const currentPath = Astro.url.pathname;

/** `/` must match exactly, the rest by prefix so a tag page stays highlighted. */
const isCurrent = (href: string) =>
  href === '/' ? currentPath === '/' : currentPath.startsWith(href);
---

<header class="header glass" role="banner">
  <nav class="container header__nav" aria-label="Navigation principale">
    <a class="header__brand" href="/" aria-label="zatsit, accueil du blog">
      <LogoIcon class="header__logo" aria-hidden="true" />
      <span class="header__wordmark">zatsit</span>
    </a>

    <ul class="header__links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="header__link"
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>

    {/* A direct child of the nav rather than of the actions group, so it can
        wrap onto its own full-width row below 1024px. Rendering a second
        instance inside the mobile menu would have been the other option, and
        would have duplicated the element ids the search script looks up. */}
    <div class="header__search">
      <Search />
    </div>

    <div class="header__actions">
      <ul class="header__ecosystem">
        <li>
          <a
            class="header__action"
            href={WEBSITE_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Le site zatsit.fr, dans un nouvel onglet"
          >
            <Globe class="icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            class="header__action"
            href={SUSTAINABILITY_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Le portail Sustainability, dans un nouvel onglet"
          >
            <SustainabilityIcon class="icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            class="header__action"
            href={LINKEDIN_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Le LinkedIn de zatsit, dans un nouvel onglet"
          >
            <LinkedinIcon class="icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            class="header__action"
            href={GITHUB_URL}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Le GitHub de zatsit, dans un nouvel onglet"
          >
            <GithubIcon class="icon" aria-hidden="true" />
          </a>
        </li>
        <li>
          <a
            class="header__action"
            href={`mailto:${CONTACT_EMAIL}`}
            aria-label={`Écrire à ${CONTACT_EMAIL}`}
          >
            <Mail class="icon" aria-hidden="true" />
          </a>
        </li>
      </ul>

      <ThemeToggle />

      <button
        id="menu-button"
        class="header__menu-button"
        type="button"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Menu class="icon menu-icon--open" aria-hidden="true" />
        <X class="icon menu-icon--close" aria-hidden="true" />
      </button>
    </div>
  </nav>

  {/* Navigation only: the ecosystem icons and the mail link stay in the bar at
      every width, so repeating them here would be a duplicate. */}
  <div id="mobile-menu" class="header__mobile" hidden>
    <ul class="container header__mobile-links">
      {
        NAV_LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="header__link"
              aria-current={isCurrent(link.href) ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-block-end: var(--border-width) solid var(--glass-border);
  }

  /* Wraps on purpose: below 1024px the search takes the second row, which is
     the only way to keep one instance of it and still fit a logo, five
     ecosystem icons, a theme toggle and a menu button on a 375px screen. */
  .header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
    min-block-size: 4rem;
    padding-block: var(--space-2);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__logo {
    inline-size: 2rem;
    block-size: 2rem;
    color: var(--color-primary);
  }

  /* Hidden until the navigation unfolds at 1024px: below that the row needs
     the width for the ecosystem icons, and the sigle already carries the
     brand. The brand link's aria-label names it either way. */
  .header__wordmark {
    display: none;
    color: var(--color-primary);
    font-size: var(--text-2xl);
    font-weight: var(--font-semibold);
    line-height: 1;
  }

  .header__links {
    display: none;
    align-items: center;
    gap: var(--space-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .header__link {
    color: var(--color-text-muted);
    font-weight: var(--font-medium);
    font-size: var(--text-base);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__link:hover {
    color: var(--color-text);
    text-decoration: underline;
  }

  /* Current page carries weight and colour, never colour alone. */
  .header__link[aria-current='page'] {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.35em;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Full width on its own row, after the brand and the actions. */
  .header__search {
    order: 3;
    flex-basis: 100%;
  }

  /* `flex-wrap` is a safety valve for the narrowest phones, not a layout:
     under roughly 360px the five icons take a second line instead of forcing
     the page to scroll sideways. From 640px the row is locked to one line and
     refuses to shrink, so a crowded bar squeezes the search field and the
     navigation instead of breaking the icons onto two and three lines. */
  .header__ecosystem {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Icon-only control. 44px tall everywhere, but 36px wide below 640px, where
     five of them plus the toggle and the menu button have to share a 375px
     row. Every one of these links is repeated as a 44px disc in the footer,
     so the narrow target is never the only way to reach it. */
  .header__action {
    display: grid;
    place-items: center;
    min-inline-size: 2.25rem;
    min-block-size: 2.75rem;
    border-radius: var(--radius-md);
    color: var(--color-primary);
    text-decoration: none;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .header__action:hover {
    background-color: var(--color-surface);
  }

  .header__menu-button {
    display: grid;
    place-items: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius-md);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: background-color var(--duration-fast) var(--ease-out);
  }

  .header__menu-button:hover {
    background-color: var(--color-surface);
  }

  .menu-icon--open,
  .menu-icon--close {
    grid-area: 1 / 1;
  }

  .menu-icon--close {
    display: none;
  }

  .header__menu-button[aria-expanded='true'] .menu-icon--open {
    display: none;
  }

  .header__menu-button[aria-expanded='true'] .menu-icon--close {
    display: block;
  }

  .header__mobile {
    border-block-start: var(--border-width) solid var(--color-border);
    background: var(--color-bg);
  }

  .header__mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding-block: var(--space-6);
  }

  .header__mobile-links .header__link {
    font-size: var(--text-lg);
  }

  @media (min-width: 640px) {
    .header__action {
      min-inline-size: 2.75rem;
    }

    .header__ecosystem {
      flex-wrap: nowrap;
      flex-shrink: 0;
      gap: var(--space-1);
    }
  }

  @media (min-width: 768px) {
    .header__logo {
      inline-size: 2.5rem;
      block-size: 2.5rem;
    }

    .header__nav {
      min-block-size: 5rem;
      gap: var(--space-2) var(--space-4);
    }

    .header__actions {
      gap: var(--space-4);
    }
  }

  @media (min-width: 1280px) {
    .header__links {
      gap: var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .header__nav {
      flex-wrap: nowrap;
      block-size: 5rem;
      padding-block: 0;
    }

    /* Back inline, and pushed to the right so it sits against the ecosystem
       icons rather than floating in the middle: with a handful of navigation
       entries left, `space-between` alone left a gap on either side of it. The
       auto margin ends the left-hand group instead. */
    .header__links {
      /* Detached from the wordmark, or "zatsit Blog" reads as one phrase. */
      margin-inline-start: var(--space-8);
      margin-inline-end: auto;
      /* Tighter than the design gap until 1280px: with the wordmark back and
         the search field inline, 32px between five entries did not fit. */
      gap: var(--space-4);
      min-inline-size: 0;
    }

    .header__search {
      order: 0;
      flex-basis: auto;
      min-inline-size: 0;
    }

    .header__links {
      display: flex;
    }

    .header__wordmark {
      display: inline;
    }

    .header__menu-button,
    .header__mobile {
      display: none;
    }
  }
</style>

<script>
  function initMenu() {
    const button = document.getElementById('menu-button');
    const menu = document.getElementById('mobile-menu');
    if (!button || !menu) return;

    // The label follows the state, so a screen reader announces what the next
    // click does rather than what the button opened last time.
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      button.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu');
      (menu as HTMLElement).hidden = !open;
    };

    setOpen(false);

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and hands focus back to the trigger, so a keyboard user is
    // never left stranded inside a panel they cannot see.
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (button.getAttribute('aria-expanded') !== 'true') return;
      setOpen(false);
      button.focus();
    });
  }

  initMenu();
  document.addEventListener('astro:after-swap', initMenu);
</script>
