---
/**
 * Section navigation for an article, pinned beside the text on wide screens
 * and following it down as you read.
 *
 * Two levels: the h2s carry the argument, the h3s say what is inside each
 * step. Deeper than that and a map becomes a transcript.
 *
 * Desktop only, and that is a layout fact rather than a preference: the column
 * exists because there is unused space next to a 68ch measure. Below that
 * width there is no space, and a list of sections stacked above the article is
 * one more thing to scroll past before reading.
 */
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}

/** Flat headings into the two-level tree the markup needs. */
const sections: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];

for (const heading of Astro.props.headings) {
  if (heading.depth === 2) {
    sections.push({ heading, children: [] });
  } else if (heading.depth === 3 && sections.length > 0) {
    // An h3 before any h2 has no parent to hang from. Dropping it is right:
    // it means the article opens at depth three, and its own outline is off.
    sections.at(-1)!.children.push(heading);
  }
}

const total = sections.length + sections.reduce((n, s) => n + s.children.length, 0);
---

{
  total > 1 && (
    <nav class="toc" aria-labelledby="toc-title">
      <p class="toc__title" id="toc-title">
        Sommaire
      </p>

      <ol class="toc__list">
        {sections.map(({ heading, children }) => (
          <li>
            <a class="toc__link" href={`#${heading.slug}`} data-toc-link>
              {heading.text}
            </a>

            {children.length > 0 && (
              <ol class="toc__list toc__list--nested">
                {children.map((child) => (
                  <li>
                    <a
                      class="toc__link toc__link--nested"
                      href={`#${child.slug}`}
                      data-toc-link
                    >
                      {child.text}
                    </a>
                  </li>
                ))}
              </ol>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )
}

<style>
  .toc {
    position: sticky;
    /* Clears the sticky header, 5rem tall on desktop. */
    inset-block-start: calc(5rem + var(--space-8));
    /* Its own scrollbar when an article has more sections than the viewport
       can hold, so a long summary never pushes the page taller. */
    max-block-size: calc(100vh - 5rem - var(--space-16));
    overflow-y: auto;
    padding-inline-end: var(--space-3);
    scrollbar-width: thin;
  }

  .toc__title {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-xs);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    /* The rule the active marker lights up along. */
    border-inline-start: var(--border-width) solid var(--color-border);
  }

  /* The nested list carries no rule of its own: one continuous line down the
     whole summary reads as a single spine, two nested lines as a diagram. */
  .toc__list--nested {
    border-inline-start: 0;
  }

  .toc__link {
    display: block;
    /* 24px, the target minimum. The nested variant sets a tighter padding and
       a smaller size, and came out at 23px: one pixel short of 2.5.5, on every
       article with a third-level heading. */
    min-block-size: 1.5rem;
    padding: var(--space-2) 0 var(--space-2) var(--space-4);
    /* Sits on top of the list's rule, so the active state reads as that rule
       lighting up rather than a second line appearing beside it. */
    margin-inline-start: calc(var(--border-width) * -1);
    border-inline-start: var(--border-width-strong) solid transparent;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    text-decoration: none;
    transition:
      color var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .toc__link--nested {
    padding-block: var(--space-1);
    padding-inline-start: var(--space-8);
    font-size: var(--text-xs);
  }

  .toc__link:hover {
    color: var(--color-text);
  }

  .toc__link[aria-current='true'] {
    border-inline-start-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: var(--font-semibold);
  }

  @media (prefers-reduced-motion: reduce) {
    .toc__link {
      transition: none;
    }
  }
</style>

<script>
  /**
   * Marks the section being read. Without it the list is a set of links; with
   * it, it also says where you are.
   *
   * An IntersectionObserver rather than a scroll listener: the browser does
   * the work off the main thread, with no handler firing every frame. The top
   * margin matches the sticky header, so a heading counts as reached when it
   * clears the header rather than when it slides underneath.
   */
  function init() {
    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    if (links.length === 0) return;

    const byId = new Map(
      links.map((link) => [decodeURIComponent(link.hash.slice(1)), link]),
    );
    const headings = [...byId.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);
    if (headings.length === 0) return;

    let current: HTMLAnchorElement | null = null;

    const mark = (id: string) => {
      const link = byId.get(id);
      if (!link || link === current) return;
      current?.removeAttribute('aria-current');
      link.setAttribute('aria-current', 'true');
      current = link;

      // Keep the active entry in view when the summary has its own scrollbar,
      // otherwise the highlight walks off the bottom of a long list.
      link.scrollIntoView({ block: 'nearest', behavior: 'auto' });
    };

    const observer = new IntersectionObserver(
      (entries) => {
        // The topmost heading inside the reading band wins. Taking the last
        // intersecting entry would jump to the bottom of the screen instead.
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);

        if (visible[0]) mark(visible[0].target.id);
      },
      { rootMargin: '-88px 0px -70% 0px', threshold: 0 },
    );

    for (const heading of headings) observer.observe(heading);
    mark(headings[0].id);
  }

  init();
  document.addEventListener('astro:after-swap', init);
</script>
