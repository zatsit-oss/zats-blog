---
/**
 * One article in a listing. Shared by the paginated home, the tag pages and
 * the archive, so they cannot drift apart.
 *
 * The hover treatment is the design system's signature, which nothing in this
 * site implemented until now: a 4px lift, a primary rule appearing along the
 * top edge, and a diffuse primary glow. The system is explicit that elevation
 * comes from tonal layers and hairlines rather than heavy shadows, so the
 * resting state carries no shadow at all.
 */
import type { CollectionEntry } from 'astro:content';
import FormattedDate from './FormattedDate.astro';
import { excerpt, readingTime } from '../utils/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  /**
   * The lead article of the first page. Wider, larger, with a longer excerpt:
   * on a blog the newest piece is why most readers came, and a listing where
   * every item weighs the same makes them work that out for themselves.
   */
  featured?: boolean;
  /**
   * One level below the heading of the listing that holds the card, so the
   * articles read as being inside their section rather than beside it. The
   * listing passes it down: `h1` on a tag page and the archive gives `h2`
   * here, `h2` on the home page gives `h3`. Every card was an `h2` before,
   * which put the eleven titles of the home page at the same level as
   * "Derniers articles" for anyone browsing by heading.
   */
  headingLevel?: 'h2' | 'h3';
}

const { post, featured = false, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const { title, slug, date, tags } = post.data;

const href = `/${slug}/`;
const summary = excerpt(post);
const minutes = readingTime(post);
---

<article class:list={['card', featured && 'card--featured']}>
  <div class="card__meta">
    {date && <FormattedDate date={date} format="short" />}
    <span aria-hidden="true">·</span>
    <span>{minutes} min de lecture</span>
  </div>

  <Heading class="card__title">
    {/* The title is the link, not the whole card: the accessible name stays
        the title rather than every word of the summary. */}
    <a class="card__link" href={href}>{title}</a>
  </Heading>

  {summary && <p class="card__excerpt">{summary}</p>}

  {
    tags.length > 0 && (
      <ul class="card__tags">
        {tags.map((tag) => (
          <li>
            <a class="card__tag" href={`/tags/${tag}/`}>
              {tag}
            </a>
          </li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--space-6);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg);
    transition:
      transform var(--duration-base) var(--ease-out),
      box-shadow var(--duration-base) var(--ease-out),
      border-color var(--duration-base) var(--ease-out);
  }

  /* The accent rule, hidden until the card is pointed at or its link focused.
     A pseudo-element rather than a border, so nothing shifts when it appears. */
  .card::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline: var(--space-6);
    block-size: 2px;
    border-radius: var(--radius-full);
    background: var(--color-primary);
    opacity: 0;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .card:hover,
  .card:focus-within {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--color-primary) 40%, var(--color-border));
    box-shadow: var(--shadow-lift);
  }

  .card:hover::before,
  .card:focus-within::before {
    opacity: 1;
  }

  .card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .card__title {
    margin: var(--space-2) 0 0;
    font-size: var(--text-xl);
    line-height: var(--leading-snug);
  }

  .card__link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Extends the hit area to the whole card without swallowing the accessible
     name. The tag links sit above it thanks to their own stacking context. */
  .card__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card:hover .card__link {
    color: var(--color-primary);
  }

  .card__excerpt {
    margin-block: var(--space-3) 0;
    color: var(--color-text-muted);
    /* Three lines keeps every card the same height whatever the author wrote
       above the truncate marker. */
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__tags {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    /* Pushed to the bottom so tags align across a row of uneven cards. */
    margin: auto 0 0;
    padding-block-start: var(--space-4);
  }

  /* Plain text rather than pills: the card already has a border, and pills
     inside a bordered box read as noise.

     In the theme's accent, so the tags read as the one interactive thing in
     an otherwise quiet card, and so they carry the dual theme: brand blue in
     light, gold in dark. Measured at 8.25:1 and 10.01:1 against the card
     background, well clear of AA for text this small. */
  .card__tag {
    color: var(--color-primary);
    font-size: var(--text-xs);
    /* 700, one of the three weights the site ships. Not --font-medium: that is
       500, which is not embedded, and the browser would fake it. */
    font-weight: var(--font-bold);
    text-decoration: none;
  }

  /* The hash is a marker, not a word: dimmed so the tag itself reads first. */
  .card__tag::before {
    content: '#';
    opacity: 0.55;
  }

  .card__tag:hover,
  .card__tag:focus-visible {
    color: var(--color-primary-hover);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .card--featured .card__title {
    font-size: var(--text-2xl);
  }

  .card--featured .card__excerpt {
    -webkit-line-clamp: 4;
    font-size: var(--text-lg);
  }

  @media (min-width: 768px) {
    .card--featured {
      padding: var(--space-8);
    }

    .card--featured::before {
      inset-inline: var(--space-8);
    }

    .card--featured .card__title {
      font-size: var(--text-3xl);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card::before {
      transition: none;
    }

    .card:hover,
    .card:focus-within {
      transform: none;
    }
  }
</style>
