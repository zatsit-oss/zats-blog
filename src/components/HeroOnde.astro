---
/**
 * Hero illustration: a terminal broadcasting, and the waves carry the blog's
 * four domains.
 *
 * From the Claude Design project "Illustrations hero banner Zatsit", board 2a,
 * the one its own caption marks as retained. The design's reasoning: no drawn
 * scene, an abstract composition in the design system's language, everything in
 * tokens and `currentColor` so the theme switch costs nothing.
 *
 * Adapted like the tag cloud it shares the hero with: `green` was set in
 * `--color-eco`, which measures 2.01:1 on this band in the light theme and so
 * failed as text at 15px, and now uses `--color-eco-text`. The concentric arcs
 * keep their low opacities: at 2.45:1 they would fail 1.4.11, but that applies
 * to interface components and to graphics needed to understand the content, and
 * these are neither. The label carries the meaning.
 */
---

<svg
  class="onde"
  viewBox="0 0 600 460"
  role="img"
  aria-label="Illustration : un terminal diffuse des ondes concentriques qui portent les quatre domaines du blog, architecture, cloud, data et IA, et green."
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <radialGradient id="onde-glow" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0" stop-color="currentColor" stop-opacity="0.28"></stop>
      <stop offset="1" stop-color="currentColor" stop-opacity="0"></stop>
    </radialGradient>
  </defs>

  <g class="onde__glow">
    <ellipse cx="190" cy="320" rx="230" ry="200" fill="url(#onde-glow)"></ellipse>
  </g>

  {/* Five arcs, fading as they travel: what leaves the terminal reaches further
      and quieter. */}
  <g class="onde__waves" fill="none" stroke-linecap="round" stroke-width="1.6">
    <path d="M142 240 A 90 90 0 0 1 239 343" stroke-opacity="0.4"></path>
    <path d="M137 181 A 150 150 0 0 1 299 351" stroke-opacity="0.3"></path>
    <path d="M132 121 A 210 210 0 0 1 358 359" stroke-opacity="0.22"></path>
    <path d="M126 61 A 270 270 0 0 1 417 368" stroke-opacity="0.15"></path>
    <path d="M121 2 A 330 330 0 0 1 477 376" stroke-opacity="0.09"></path>
  </g>

  <g class="onde__trail">
    <circle cx="166" cy="241" r="3.5"></circle>
    <circle cx="214" cy="266" r="3.5" fill-opacity="0.6"></circle>
    <circle cx="239" cy="314" r="3.5" fill-opacity="0.35"></circle>
  </g>

  <g class="onde__labels" font-size="15">
    <g class="onde__label">
      <circle cx="189" cy="185" r="11" fill-opacity="0.15"></circle>
      <circle cx="189" cy="185" r="5"></circle>
      <text x="208" y="190">architecture</text>
    </g>
    <g class="onde__label">
      <circle cx="316" cy="201" r="11" fill-opacity="0.15"></circle>
      <circle cx="316" cy="201" r="5"></circle>
      <text x="335" y="206">cloud</text>
    </g>
    <g class="onde__label">
      <circle cx="268" cy="87" r="11" fill-opacity="0.15"></circle>
      <circle cx="268" cy="87" r="5"></circle>
      <text x="287" y="92">data &amp; IA</text>
    </g>
    <g class="onde__label onde__label--eco">
      <circle cx="411" cy="260" r="11" fill-opacity="0.15"></circle>
      <circle cx="411" cy="260" r="5"></circle>
      <text x="430" y="265">green</text>
    </g>
  </g>

  {/* The terminal itself: the prompt glyph, drawn rather than typed, so no
      character can go missing with a font. */}
  <g class="onde__terminal">
    <rect x="110" y="290" width="80" height="80" rx="16"></rect>
  </g>
  <g class="onde__prompt" fill="none" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
    <path d="M130 318 l13 12 l-13 12"></path>
    <path d="M152 342 h18"></path>
  </g>
</svg>

<style>
  .onde {
    inline-size: min(30rem, 46%);
    block-size: auto;
    flex-shrink: 0;
    overflow: visible;
  }

  .onde__glow,
  .onde__trail,
  .onde__terminal {
    color: var(--color-primary);
    fill: currentColor;
  }

  .onde__waves {
    stroke: var(--color-text);
  }

  .onde__labels {
    font-family: var(--font-sans);
    font-weight: var(--font-semibold);
  }

  .onde__label {
    fill: var(--color-primary);
  }

  .onde__label--eco {
    fill: var(--color-eco-text);
  }

  .onde__prompt {
    stroke: var(--color-on-primary);
  }

  /* Below the breakpoint where the hero stacks, the figure would push the
     actions off the first screen for nothing. */
  @media (max-width: 899px) {
    .onde {
      display: none;
    }
  }
</style>
