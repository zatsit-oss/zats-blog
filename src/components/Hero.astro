---
/**
 * Home page hero.
 *
 * New to the Astro version: the Docusaurus home was the article listing and
 * nothing else. There is therefore no previous version to match, and the copy
 * below is a starting point rather than a decision.
 *
 * Everything it says comes from props, so changing the wording never means
 * touching this file. The eyebrow, the actions and the illustration are all
 * optional: with none of them it degrades to a title and a sentence.
 */
interface Props {
  /** Small line above the title. Skipped when absent. */
  eyebrow?: string;
  title: string;
  /**
   * Word or short phrase inside `title` to render in the brand gradient. The
   * design system allows one per heading, no more. Ignored when `counterpoint`
   * is set: two accents in one heading is one too many.
   */
  highlight?: string;
  /**
   * Second clause of the title, set on its own line in italic and in the
   * accent colour. The device is borrowed from littlemight.com, where a roman
   * statement is answered by an italic one: the rupture is a change of style,
   * not just of colour, which is what a bolded word alone never achieves.
   *
   * It costs nothing to ship. Poppins italic is already among the six woff2
   * the site downloads, and until now it served only blockquotes.
   */
  counterpoint?: string;
  subtitle?: string;
  /** Readonly, because HERO in consts.ts is declared `as const`. */
  actions?: readonly { readonly href: string; readonly label: string; readonly primary?: boolean }[];
  /** Root-relative path to a decorative illustration. */
  illustration?: string;
}

const { eyebrow, title, highlight, counterpoint, subtitle, actions = [], illustration } = Astro.props;

// Split the title around the highlighted phrase so the gradient wraps that
// phrase alone. Falls back to a plain title when there is nothing to match.
// `hasHighlight` is tracked separately rather than inferred from the halves:
// a phrase that ends the title leaves an empty second half, which is a
// successful match and not a failed one.
const hasHighlight = Boolean(highlight && title.includes(highlight) && !counterpoint);
const [before, after] = hasHighlight ? title.split(highlight!) : [title, ''];
---

<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      {eyebrow && <p class="hero__eyebrow">{eyebrow}</p>}

      <h1 class="hero__title">
        {before}{hasHighlight && <span class="text-gradient">{highlight}</span>}{after}
        {counterpoint && <em class="hero__counterpoint">{counterpoint}</em>}
      </h1>

      {subtitle && <p class="hero__subtitle">{subtitle}</p>}

      {
        actions.length > 0 && (
          <div class="hero__actions">
            {actions.map((action) => (
              <a
                class:list={['hero__action', action.primary && 'hero__action--primary']}
                href={action.href}
              >
                {action.label}
              </a>
            ))}
          </div>
        )
      }
    </div>

    {
      illustration && (
        <img
          class="hero__illustration"
          src={illustration}
          alt=""
          aria-hidden="true"
          width="320"
          height="320"
        />
      )
    }
  </div>
</section>

<style>
  .hero {
    border-block-end: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    /* The band's own breathing, and the page's opening space at the same
       time: main stands its padding down for a page that starts here. */
    padding-block: var(--rhythm-open);
  }

  .hero__text {
    max-width: 40rem;
  }

  .hero__eyebrow {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: var(--font-semibold);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .hero__title {
    margin: 0;
    font-size: var(--text-4xl);
    /* The two clauses sit tighter than the default heading leading, so they
       read as one sentence in two voices rather than two headings. */
    line-height: var(--leading-tight);
  }

  /* Its own line, always: the counterpoint answers the statement, it does not
     continue it. `display: block` rather than a <br>, so the break belongs to
     the styling and the text stays one sentence for a screen reader. */
  .hero__counterpoint {
    display: block;
    color: var(--color-primary);
    font-style: italic;
    /* Regular, not the heading's bold. Compared side by side at 400, 600 and
       700: bold italic in a saturated accent amplifies the first clause instead
       of answering it, which is the opposite of the effect. The three italics
       all ship already, so the weight costs nothing either way. */
    font-weight: var(--font-regular);
  }

  .hero__subtitle {
    margin: var(--space-4) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-6);
  }

  .hero__action {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--space-12);
    padding-inline: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .hero__action:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .hero__action--primary {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .hero__action--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: var(--color-on-primary);
  }

  .hero__illustration {
    inline-size: 100%;
    max-inline-size: 20rem;
    block-size: auto;
    align-self: center;
  }

  @media (min-width: 900px) {
    .hero__inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-16);
    }

    .hero__title {
      font-size: var(--text-5xl);
    }
  }
</style>
