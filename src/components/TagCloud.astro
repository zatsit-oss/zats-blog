---
/**
 * The seventeen tags as a cloud of links, sized by how much is written on
 * each. Lives at the foot of /categories/, under the six category cards.
 *
 * "Tag" is the word the reader reads, as of 28 August. It is also the word in
 * the frontmatter and in the URL, which is the whole argument: "thème", tried
 * for two days, asked the reader to translate a term the site spells `tags`
 * everywhere else. The rule that mattered is untouched, a tag is never called
 * a category.
 *
 * Not `HeroTagCloud.astro`, and it could not be: that one is the illustration
 * from the Claude Design board, a frozen SVG with `role="img"`, a single label
 * for the whole figure and not one word that is a link. It says what the blog
 * talks about. This one is navigation, so every word is an anchor, the sizes
 * come from `allTags()` rather than from a design file, and the two will not
 * drift apart the way the illustration already has: its label still reads
 * "frontend" where the corpus carries "angular".
 *
 * ## Why the sizes come from the ranks and not from the counts
 *
 * The distribution is skewed: one theme has six articles, five have three, five
 * have two, six have one. Mapping the count linearly onto four steps puts 2 and
 * 3 on the same rung and leaves a rung unused, which loses the only distinction
 * a cloud exists to draw. Ranking the *distinct* counts spends the whole scale
 * and stays monotonic, so a bigger word always means more articles.
 *
 * ## Size, and weight doing half the work
 *
 * Four steps from 16px to 24px, the largest still under the 30px of the section
 * heading above it, with the weight climbing 400, 400, 600, 700. Those are the
 * three weights the site actually downloads: asking for 500 would have the
 * browser synthesise it. Deliberately a narrow range: a word at 36px would
 * outweigh the heading it sits under, and the widest gap in the corpus is six
 * articles against one.
 *
 * Every word is one colour, and hierarchy is carried by size and weight alone.
 * Fading the small words is the mistake the hero illustration already paid for:
 * `fill-opacity: 0.65` measured 3.14:1 against a 4.5:1 requirement.
 *
 * ## Target size
 *
 * A word in a cloud is a navigation target, and the smallest here sets at 16px.
 * Rather than argue the spacing exception of 2.5.8, each link takes the 40px
 * minimum height the theme chips already use, which passes 2.5.5 outright and
 * comes close to the 44px a thumb wants. The height is invisible: it only pads
 * the line box the word already occupies.
 */
import type { TagSummary } from '../utils/posts';

interface Props {
  tags: TagSummary[];
  /** Id for the heading, so the page can link to this section. */
  id?: string;
}

const { tags, id = 'tags' } = Astro.props;

/** How many rungs the scale has. Four suits a corpus of nineteen articles. */
const STEPS = 4;

/**
 * The distinct counts, ascending. A theme's step is the position of its own
 * count in that list, spread over the available rungs, so the scale is used
 * end to end whether the corpus has four distinct counts or twelve.
 */
const distinct = [...new Set(tags.map(({ count }) => count))].sort((a, b) => a - b);

function step(count: number): number {
  const rank = distinct.indexOf(count);
  return 1 + Math.floor((rank * STEPS) / distinct.length);
}

/**
 * Alphabetical, where the /tags/ index was ordered by count. In a cloud the
 * size already says which tags are the busiest, so ordering by count says it
 * twice and leaves the reader no way to find a word they came looking for.
 */
const words = [...tags].sort((a, b) => a.tag.localeCompare(b.tag, 'fr'));
---

<section class="container cloud" aria-labelledby={id}>
  <h2 id={id}>Tags</h2>

  <p class="cloud__intro">
    Un article n'a qu'une catégorie, mais autant de tags qu'il aborde de sujets. Les
    {tags.length} tags du blog, du plus au moins écrit : c'est ici que se croisent deux articles
    rangés à des endroits différents.
  </p>

  <ul class="cloud__list">
    {
      words.map(({ tag, count }) => (
        <li>
          <a class={`cloud__word cloud__word--${step(count)}`} href={`/tags/${tag}/`}>
            {tag}
            <span class="sr-only">, {count === 1 ? 'un article' : `${count} articles`}</span>
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  /* The same measure as the category cards above, so the two sections of the
     page share one left edge and one right one. */
  .cloud {
    max-width: 48rem;
  }

  .cloud__intro {
    margin: var(--space-3) 0 var(--space-6);
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .cloud__list {
    display: flex;
    flex-wrap: wrap;
    /* Baseline, not centre: the words sit on a common line the way type does,
       which is what keeps a mixed-size row from reading as debris. */
    align-items: baseline;
    column-gap: var(--space-4);
    row-gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .cloud__word {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--space-10);
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .cloud__word:hover,
  .cloud__word:focus-visible {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .cloud__word--1 {
    font-size: var(--text-base);
    font-weight: var(--font-regular);
  }

  .cloud__word--2 {
    font-size: var(--text-lg);
    font-weight: var(--font-regular);
  }

  .cloud__word--3 {
    font-size: var(--text-xl);
    font-weight: var(--font-semibold);
  }

  .cloud__word--4 {
    font-size: var(--text-2xl);
    font-weight: var(--font-bold);
  }

  @media (prefers-reduced-motion: reduce) {
    .cloud__word {
      transition: none;
    }
  }
</style>
