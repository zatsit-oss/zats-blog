---
/**
 * The three promises of the blog: why we write, how the site is built, and the
 * invitation to join.
 *
 * The copy is recovered verbatim from HomepageFeatures, a Docusaurus component
 * that lived in src/components for three years without any page importing it.
 * It was written and never read by anyone.
 *
 * Placed after the article listing rather than between it and the hero: this
 * is a blog, the articles are the content, and a recruitment note reads better
 * as a closing than as a toll gate. Moving it is one line in index.astro.
 */
import { Picture } from 'astro:assets';
import learning from '../assets/home/learning-amico.png';
import designer from '../assets/home/website-designer-cuate.png';
import resume from '../assets/home/resume-amico.png';

const features = [
  {
    title: 'Écrire pour partager',
    image: learning,
    href: '/',
    body: "Nos consultants ont du talent et souhaitent vous partager leurs connaissances, leurs valeurs. N'hésitez pas à partager si vous aimez.",
  },
  {
    title: 'Simple, efficace et surtout éco-conçu',
    image: designer,
    href: '/blog-conception/',
    body: 'Ce blog est entièrement généré à la publication et ne mobilise aucune ressource serveur le reste du temps.',
  },
  {
    title: 'Si vous aimez ce que vous lisez',
    image: resume,
    href: 'mailto:emplois@zatsit.fr',
    body: "Vous pourriez faire partie de l'aventure. Rejoindre une équipe motivée par la qualité, la sobriété et le partage.",
  },
];
---

<section class="features" aria-labelledby="features-heading">
  <div class="container">
    <h2 id="features-heading" class="features__heading">Ce blog en trois idées</h2>

    <ul class="features__list">
      {
        features.map((feature) => (
          <li class="feature">
            {/* Decorative: the title right below says the same thing. Lazy,
                since this section sits below the article listing. */}
            {/* fallbackFormat webp, not the default png: the fallback exists
                for browsers without avif, and every one of those still has
                webp. Left at png it emitted a 119 kB file nothing would
                fetch. */}
            <Picture
              class="feature__image"
              src={feature.image}
              formats={['avif']}
              fallbackFormat="webp"
              widths={[200, 400]}
              sizes="(min-width: 900px) 200px, 45vw"
              alt=""
              loading="lazy"
            />
            <h3 class="feature__title">
              <a class="feature__link" href={feature.href}>
                {feature.title}
              </a>
            </h3>
            <p class="feature__body">{feature.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .features {
    border-block-start: var(--border-width) solid var(--color-border);
    background: var(--color-surface);
  }

  .features__heading {
    margin: 0 0 var(--space-8);
    font-size: var(--text-2xl);
    text-align: center;
  }

  .features__list {
    display: grid;
    gap: var(--space-10);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .feature {
    position: relative;
    text-align: center;
  }

  .feature__image {
    inline-size: 100%;
    max-inline-size: 12.5rem;
    block-size: auto;
    margin-inline: auto;
  }

  .feature__title {
    margin: var(--space-4) 0 var(--space-2);
    font-size: var(--text-xl);
  }

  .feature__link {
    color: var(--color-text);
    text-decoration: none;
  }

  /* Extends the hit area to the whole card while keeping the accessible name
     the title alone. */
  .feature__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .feature__link:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .feature__body {
    margin: 0;
    color: var(--color-text-muted);
  }

  .features > :global(.container) {
    padding-block: var(--space-16);
  }

  @media (min-width: 900px) {
    .features__list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-12);
    }
  }
</style>
