---
/**
 * Home: the hero, then the first page of the article listing.
 *
 * Pages 2 and beyond live in src/pages/page/[page].astro rather than coming
 * from a single paginate() call, because Astro's pagination would emit /2/ and
 * the Docusaurus URL to preserve is /page/2/. They carry no hero: it belongs to
 * the entrance, not to every page of a list.
 */
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import HeroTagCloud from '../components/HeroTagCloud.astro';
import BlogFacts from '../components/BlogFacts.astro';
import BuiltWith from '../components/BuiltWith.astro';
import PostList from '../components/PostList.astro';
import RandomArticle from '../components/RandomArticle.astro';
import { listingPages, sortedPosts } from '../utils/posts';
import { HOME_TITLE, SITE_DESCRIPTION, HERO } from '../consts';

const posts = await sortedPosts();
// Page one, from the shared split: the featured article plus a full grid.
const [firstPage] = listingPages(posts);
---

<Layout title={HOME_TITLE} description={SITE_DESCRIPTION}>
  <Hero
    eyebrow={HERO.eyebrow}
    title={HERO.title}
    counterpoint={HERO.counterpoint}
    subtitle={HERO.subtitle}
    actions={HERO.actions}
  >
    {/* Board 3a of the design project. Board 2a, the terminal broadcasting
        waves, is in the design project and was not kept: an unused component
        that no check covers goes stale, and it is one import away if wanted. */}
    <HeroTagCloud slot="figure" />
  </Hero>

  <BlogFacts posts={posts} />

  <BuiltWith />

  <PostList
    posts={firstPage.posts}
    heading="Derniers articles"
    headingLevel="h2"
    lead
    current={1}
    total={firstPage.total}
    nextUrl={firstPage.total > 1 ? '/page/2/' : undefined}
  >
    {/* Draws from the whole corpus, not from the ten shown below. */}
    <RandomArticle slot="action" posts={posts} />
  </PostList>
</Layout>
