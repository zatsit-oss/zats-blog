---
/**
 * Listing pages 2 and beyond, at /page/2/, /page/3/ and so on.
 *
 * Page 1 is the root and is not generated here: Docusaurus served it at / and
 * never at /page/1/, so generating that route would invent a URL the migration
 * is supposed to leave untouched.
 */
import type { GetStaticPaths } from 'astro';
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { sortedPosts } from '../../utils/posts';
import type { CollectionEntry } from 'astro:content';
import { SITE_TITLE, SITE_DESCRIPTION, POSTS_PER_PAGE } from '../../consts';

interface Props {
  posts: CollectionEntry<'blog'>[];
  current: number;
  total: number;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await sortedPosts();
  const total = Math.ceil(posts.length / POSTS_PER_PAGE);

  return Array.from({ length: Math.max(0, total - 1) }, (_, index) => {
    const current = index + 2;
    const start = (current - 1) * POSTS_PER_PAGE;

    return {
      params: { page: String(current) },
      props: { posts: posts.slice(start, start + POSTS_PER_PAGE), current, total },
    };
  });
};

const { posts, current, total } = Astro.props;

// Page 2 links back to the root, not to /page/1/.
const prevUrl = current === 2 ? '/' : `/page/${current - 1}/`;
const nextUrl = current < total ? `/page/${current + 1}/` : undefined;
---

<Layout title={`Articles, page ${current}`} description={SITE_DESCRIPTION}>
  <PostList
    posts={posts}
    heading={`Le blog de ${SITE_TITLE}`}
    current={current}
    total={total}
    prevUrl={prevUrl}
    nextUrl={nextUrl}
  />
</Layout>
