---
/**
 * Not found. Wording kept from the Docusaurus page, minus its dead end: that
 * one told the visitor to contact whoever linked them here and stopped there.
 * Offering the way back costs nothing and is the whole job of a 404.
 */
import Layout from '../layouts/Layout.astro';
import { sortedPosts } from '../utils/posts';

const latest = (await sortedPosts()).slice(0, 3);
---

<Layout title="Page introuvable" description="Cette page n'existe pas ou plus.">
  <div class="container notfound">
    <p class="notfound__code" aria-hidden="true">404</p>
    <h1>Page introuvable</h1>
    <p class="notfound__lead">
      Nous n'avons pas trouvé ce que vous cherchiez. La page a peut-être été déplacée, ou
      l'adresse comporte une coquille.
    </p>

    <div class="notfound__actions">
      <a class="notfound__action notfound__action--primary" href="/">Retour aux articles</a>
      <a class="notfound__action" href="/tags/">Parcourir les tags</a>
      <a class="notfound__action" href="/archive/">Voir l'archive</a>
    </div>

    <section class="notfound__latest">
      <h2>Les derniers articles</h2>
      <ul>
        {
          latest.map((post) => (
            <li>
              <a href={`/${post.data.slug}/`}>{post.data.title}</a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Layout>

<style>
  .notfound {
    max-width: 45rem;
    padding-block: var(--space-16) var(--space-24);
  }

  .notfound__code {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-5xl);
    font-weight: var(--font-bold);
    line-height: 1;
  }

  .notfound h1 {
    margin-block: var(--space-3) var(--space-4);
  }

  .notfound__lead {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }

  .notfound__action {
    display: inline-flex;
    align-items: center;
    min-block-size: var(--space-12);
    padding-inline: var(--space-5);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-text);
    font-weight: var(--font-semibold);
    text-decoration: none;
  }

  .notfound__action:hover {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .notfound__action--primary {
    border-color: var(--color-primary);
    background: var(--color-primary);
    color: var(--color-on-primary);
  }

  .notfound__action--primary:hover {
    background: var(--color-primary-hover);
    border-color: var(--color-primary-hover);
    color: var(--color-on-primary);
  }

  .notfound__latest {
    margin-block-start: var(--space-12);
  }

  .notfound__latest h2 {
    font-size: var(--text-xl);
  }

  .notfound__latest ul {
    margin: var(--space-4) 0 0;
    padding-inline-start: var(--space-5);
  }

  .notfound__latest li + li {
    margin-block-start: var(--space-2);
  }
</style>
