---
/**
 * Index of every tag in use, at /tags/.
 *
 * Lists all seventeen, not just the six the navbar exposes: Docusaurus
 * generated a page per tag found in the corpus, and every one of those URLs
 * has to survive.
 */
import Layout from '../../layouts/Layout.astro';
import { allTags, sortedPosts } from '../../utils/posts';

const posts = await sortedPosts();
const tags = await allTags(posts);
---

<Layout
  title="Tags"
  description={`Les ${tags.length} thèmes abordés sur le blog de zatsit, du plus au moins écrit.`}
>
  <div class="container tags">
    <header class="tags__header">
      <h1>Tags</h1>
      <p class="tags__intro">
        {tags.length} thèmes, {posts.length} articles. Les catégories du menu en mettent six en avant,
        les autres existent tout autant.
      </p>
    </header>

    <ul class="tags__list">
      {
        tags.map(({ tag, count }) => (
          <li>
            <a class="tags__tag" href={`/tags/${tag}/`}>
              {tag}
              <span class="tags__count" aria-hidden="true">
                {count}
              </span>
              <span class="sr-only">, {count === 1 ? 'un article' : `${count} articles`}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>

<style>
  .tags {
    max-width: 48rem;
  }

  .tags__header {
    margin-block-end: var(--rhythm-heading);
  }

  .tags__intro {
    margin: var(--space-3) 0 0;
    color: var(--color-text-muted);
    font-size: var(--text-lg);
  }

  .tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .tags__tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: var(--space-10);
    padding-inline: var(--space-4);
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text);
    text-decoration: none;
  }

  .tags__tag:hover,
  .tags__tag:focus-visible {
    border-color: var(--color-primary);
    color: var(--color-primary);
  }

  .tags__count {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }
</style>
