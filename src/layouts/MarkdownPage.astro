---
/**
 * Layout for the standalone Markdown pages in src/pages.
 * Astro picks it up through the `layout` key in their frontmatter.
 */
import Layout from './Layout.astro';

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { title, description } = Astro.props.frontmatter;
---

<Layout title={title} description={description}>
  <article class="page">
    <h1>{title}</h1>
    <slot />
  </article>
</Layout>

<style>
  .page {
    max-width: 45rem;
    margin-inline: auto;
    padding-inline: var(--margin-mobile);
  }

  /* The ported Markdown uses h1 for each section, which would give the page
     several level-one headings. They are demoted visually here and rewritten
     as h2 in the source, so the outline stays correct for screen readers. */
  .page :global(h2) {
    margin-block-start: var(--space-10);
  }
</style>
